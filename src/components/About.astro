---
import AboutImage1 from '../images/about-image-01.png';
import AboutImage2 from '../images/about-image-02.png';
import AboutImage3 from '../images/about-image-03.png';
import AboutImage4 from '../images/about-image-04.png';
---

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  // Register ScrollTrigger plugin
  gsap.registerPlugin(ScrollTrigger);

  // Wait for DOM to be ready
  document.addEventListener('DOMContentLoaded', () => {
    // Create the animation for the about images
    const images = document.querySelectorAll('.about-image-circle');
    gsap.fromTo(images,
      {
        opacity: 0,
        y: 10,
        scale: 0.8,
      },
      {
        opacity: 1,
        y: 0,
        scale: 1,
        duration: 1,
        ease: "power2.inOut",
        stagger: 0.15,
        scrollTrigger: {
          trigger: '.about-images-container',
          start: "top 80%",
          end: "bottom 20%",
          once: true
        }
      }
    );
  });
</script>


<section class="pb-6 md:pb-10 lg:pb-20 pt-10 px-4 z-0 relative" id="about">
  <div class="container mx-auto max-w-6xl relative z-10">


    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center ">
      <!-- Image Column -->
      <div class="order-2 lg:order-1 relative z-0">
        <div class="about-images-container relative w-full aspect-square max-w-lg mx-auto">
          <!-- Top-center circle -->
          <div class="absolute top-0 left-1/2 -translate-x-1/2 top-image">
            <img
              src={AboutImage4.src}
              alt="About Partnerships For Change"
              class="about-image about-image-circle  w-full aspect-square object-cover rounded-full"
              loading="lazy"
              style="opacity: 0;"
            />
          </div>
          <!-- Mid-left circle (largest) -->
          <div class="absolute left-0 left-image">
            <img
              src={AboutImage1.src}
              alt="About Partnerships For Change"
              class="about-image about-image-circle  w-full aspect-square object-cover rounded-full"
              loading="lazy"
              style="opacity: 0;"
            />
          </div>
          <!-- Mid-right circle -->
          <div class="absolute right-0 right-image">
            <img
              src={AboutImage3.src}
              alt="About Partnerships For Change"
              class="about-image about-image-circle  w-full aspect-square object-cover rounded-full"
              loading="lazy"
              style="opacity: 0;"
            />
          </div>
          <!-- Bottom-right circle -->
          <div class="absolute bottom-image">
            <img
              src={AboutImage2.src}
              alt="About Partnerships For Change"
              class="about-image about-image-circle w-full aspect-square object-cover rounded-full"
              loading="lazy"
              style="opacity: 0;"
            />
          </div>
          <!-- Small decorative circles -->
          <div class="absolute bg-white bg-clip-content box-content small-circle-25 rounded-full about-image-circle"></div>
          <div class="absolute bg-white bg-clip-content box-content small-circle-44 rounded-full about-image-circle"></div>
          <div class="absolute bg-white bg-clip-content box-content small-circle-13 rounded-full about-image-circle"></div>
        </div>
      </div>

      <!-- Text Column -->
      <div class="order-1 lg:order-2 relative z-10">
        <div class="space-y-6 mx-auto max-w-prose text-center">
          <h2 class="text-4xl font-bold text-secondary mb-5  relative z-10">
            About Us
          </h2>
          <p class="text-base sm:text-lg text-black">
            Partnerships For Change® (PFC) is a dedicated non-profit organization committed to transforming the lives of underserved communities through sustainable development and direct humanitarian action.
          </p>

          <p class="text-base sm:text-lg text-black">
            Our mission is to empower individuals and build resilient community coalitions worldwide. We work directly with local communities to create lasting change through education, healthcare, economic development, and environmental sustainability.
          </p>

          <!-- <div class="pt-4">
            <a
              href="#contact"
              class="inline-flex items-center px-6 py-3 bg-secondary text-white font-semibold rounded-lg hover:bg-secondary/90 transition-colors duration-200"
            >
              Learn More About Our Work
              <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div> -->
        </div>
      </div>
    </div>
  </div>

 <div  id="about-gradient" class="absolute w-full h-1/3 inset-x-0 top-auto bottom-0 z-0 ">
 </div>
</section>

<style>
  #about-gradient {
    background: linear-gradient(#FFFFFF, hsla(109, 36%, 51%, 0.35) 20%,  hsla(188, 99%, 42%, 0.68) 37%, #fff 100%);
    scale: 1 4;
  }
.about-images-container {
  .about-image-circle {
    border: 8px solid hsla(0, 0%, 100%, 0.32);
  }
  .top-image {
    top: 0;
    left: 50%;
    width: 30%;
  }
  .left-image {
    left: -10%;
    top: 33%;
    width: 70%;
    @media (width >= 1024px) {
      left: 0%;
      width: 63%;
    }
  }
  .right-image {
    right: -5%;
    top:16%;
    width: 42%;
  }
  .bottom-image {
    bottom: -17%;
    right: -17%;
    width: 55%;
  }
  .small-circle-25 {
    width: 25px;
    height: 25px;
    top: 20%;
    left: 20%;
  }
  .small-circle-44 {
    width: 44px;
    height: 44px;
    top:2%;
    right: 19%;
  }
  .small-circle-13 {
    width: 13px;
    height: 13px;
    top: 55%;
    right: -5%;
  }
}

</style>
